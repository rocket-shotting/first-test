# SerpApi key — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Gmail address used to SEND notification emails
EMAIL_ADDRESS=

# Gmail App Password (NOT your normal password) — https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the Google account.
EMAIL_APP_PASSWORD=

# Address that receives the price-drop notifications (can be the same as EMAIL_ADDRESS)
NOTIFY_EMAIL=
